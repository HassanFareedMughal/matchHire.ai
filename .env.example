# MatchHire environment example
# Copy to .env and fill values. Do NOT commit secrets.

# MongoDB
MONGO_URI=

# Redis (optional)
REDIS_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES=7d

# Python path for AI engine (optional)
PYTHON_PATH=

# Google server-side verification client ID (do NOT expose this in frontend)
GOOGLE_CLIENT_ID=

# Frontend: add VITE_GOOGLE_CLIENT_ID to frontend/.env or your Vite env
# VITE_GOOGLE_CLIENT_ID=
